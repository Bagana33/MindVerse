# Supabase Configuration
# Get these values from https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Groq AI Configuration (OpenAI-compatible)
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Google Gemini AI Configuration (optional / legacy)
# Get your API key from https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key

# DeepSeek AI Configuration (optional)
DEEPSEEK_API_KEY=your_deepseek_api_key

# OpenRouter (optional)
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional but recommended for OpenRouter
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=MindVerse

# OpenAI Configuration (legacy, not used)
OPENAI_API_KEY=your_openai_api_key

# Cron Job Secret (for Vercel)
CRON_SECRET=your_cron_secret

# Cloudinary Configuration
# Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
