# ==========================================
# NeonCanvas / Mind Verse Environment Variables (Template)
# ==========================================

# 1. Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 2. Google Gemini AI (AI Chatbot, Fake Client, AI Design Critique)
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# 3. OpenRouter AI (Optional / Alternative AI provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_SITE_URL=https://your-domain.vercel.app
OPENROUTER_APP_NAME=Mind Verse

# 4. OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# 5. Cloudinary (Image & File Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 6. Cron Job Secret (for News Auto-refresh)
CRON_SECRET=your_cron_secret_here

# 7. Session Secret (Cookie Security)
NC_SESSION_SECRET=your_session_secret_here

# 8. Email / SMTP for OTP Password Reset (Choose one)
# Option A: Gmail SMTP (Recommended, simple)
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_gmail_16_char_app_password

# Option B: Resend API
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL=Mind Verse <onboarding@resend.dev>

# Option C: Custom SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Mind Verse <no-reply@mindverse.mn>

